# Actual API/prune/native keep-import method with Swing widgets. No Burp or network.
import os,sys,textwrap,itertools,unittest
from collections import OrderedDict
from javax.swing import JPanel,JTabbedPane,JTextField,JComboBox

root=os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0,root)
os.environ['BURP_DIAG_MANAGED']='1'
os.environ['BURP_DIAG_CPH_TOKEN']='anonymous-jython-fixture-'*4
from CPH_API_v0_2 import atomic_import,prune_disabled_job_tabs,on_ui_thread,CphAtomicError,same_native_config
from CPH_Validation import OPTIONS_NAME
source=open(os.path.join(root,'CustomParamHandler_marged_api_v0.2.py'),'rb').read().replace('\r\n','\n')
native_import=textwrap.dedent(source[source.index('    def load_config('):source.index('    def prepare_to_save_all(')])

class UnusedCacheImportTest(unittest.TestCase):
    def fixture(self,mode):
        class Main(object):
            mainpane=JTabbedPane()
            @staticmethod
            def get_config_tabs():
                return [Main.mainpane.getComponentAt(i) for i in range(1,Main.mainpane.getTabCount()-1)]
            @staticmethod
            def get_options_tab():return options
        class Tab(JPanel):
            def __init__(self,name=''):
                JPanel.__init__(self)
                self.namepane_txtfield=JTextField(name);self.enabled=False;self.dynamic=False;self.mode=2
                self.emv_tab=JPanel()
                self.cached=JComboBox([tab.namepane_txtfield.getText() for tab in Main.get_config_tabs()])
                self.cached.setSelectedItem(None)
                Main.mainpane.insertTab(name,None,self,None,Main.mainpane.getTabCount()-1)
                options.emv_tab_pane.add(name,self.emv_tab)
        class Options(object):
            CONFIGNAME_OPTIONS=OPTIONS_NAME
            emv_tab_pane=JTabbedPane()
            flags={'chkbox_scanner':False}
            native_imports=0
            fail_name=None
            lose_selection_once=False
            def prepare_to_save_tab(self,tab):
                selected=tab.cached.getSelectedItem()
                return {'enabled':tab.enabled,'dynamic_checkbox':tab.dynamic,'extract_choice_index':tab.mode,
                    'cached_selection':None if selected is None else unicode(selected)}
            def prepare_to_save_all(self):
                result=OrderedDict((unicode(tab.namepane_txtfield.getText()),self.prepare_to_save_tab(tab)) for tab in Main.get_config_tabs())
                result[OPTIONS_NAME]=dict(self.flags)
                return result
            def set_tab_values(self,value,tab,name=None):
                if tab is self:self.flags=dict(value);return
                tab.namepane_txtfield.setText(name);tab.enabled=value['enabled']
                tab.dynamic=value['dynamic_checkbox'];tab.mode=value['extract_choice_index']
                tab.cached.setSelectedItem(value.get('cached_selection'))
                if name==self.fail_name:
                    self.fail_name=None
                    raise CphAtomicError('CPH_SETTER_FAILED','setter')
            def load_config(self,config,replace):
                self.native_imports+=1
                scope['load_config'](self,config,replace)
                if self.lose_selection_once:
                    self.lose_selection_once=False;dest.cached.setSelectedItem(None)
        scope=dict(MainTab=Main,ConfigTab=Tab,OptionsTab=Options,product=itertools.product,
            managed=True,same_native_config=same_native_config)
        eval(compile(native_import,'production-native-load-config','exec'),scope)
        options=Options()
        Main.mainpane.add('Options',JPanel());Main.mainpane.add('+',JPanel())
        old=Tab('job:old:source')
        dest=Tab('human-unused');dest.enabled=True;dest.dynamic=mode=='single';dest.mode=0 if mode=='single' else 2
        dest.cached.setSelectedItem('job:old:source')
        self.assertEqual(1,prune_disabled_job_tabs(options,Main,['job:old:source'],options.prepare_to_save_all()))
        before=options.prepare_to_save_all()
        self.assertEqual('job:old:source',before['human-unused']['cached_selection'])
        desired=OrderedDict((name,dict(value)) for name,value in before.items() if name!=OPTIONS_NAME)
        desired['job:new:static']={'enabled':True,'dynamic_checkbox':False,'extract_choice_index':2,'cached_selection':None}
        desired[OPTIONS_NAME]=dict(options.flags)
        return options,Main,dest,before,desired

    def test_prune_then_unrelated_atomic_import_preserves_unused_static_and_single_values(self):
        def run():
            for mode in ('static','single'):
                options,main,dest,before,desired=self.fixture(mode)
                expected=OrderedDict((name,OrderedDict(reversed(list(value.items())))) for name,value in before.items())
                atomic_import(options,main,'fixture:unused:'+mode,expected,desired)
                self.assertEqual(desired,options.prepare_to_save_all())
                self.assertEqual(before['human-unused'],options.prepare_to_save_tab(dest))
                self.assertEqual(1,options.native_imports)
        on_ui_thread(run)

    def test_partial_setter_failure_restores_orphan_baseline_without_masking_original_error(self):
        def run():
            for mode in ('static','single'):
                options,main,dest,before,desired=self.fixture(mode)
                original_tabs=list(main.get_config_tabs());options.fail_name='job:new:static'
                with self.assertRaises(CphAtomicError) as caught:
                    atomic_import(options,main,'fixture:rollback:'+mode,before,desired)
                self.assertEqual('CPH_SETTER_FAILED',caught.exception.code)
                self.assertEqual(before,options.prepare_to_save_all())
                self.assertEqual(original_tabs,list(main.get_config_tabs()))
        on_ui_thread(run)

    def test_lost_unused_values_refuse_and_actual_cache_activation_refuses_before_native_import(self):
        def run():
            for mode in ('static','single'):
                options,main,dest,before,desired=self.fixture(mode)
                options.lose_selection_once=True
                with self.assertRaises(CphAtomicError) as caught:
                    atomic_import(options,main,'fixture:lost:'+mode,before,desired)
                self.assertEqual('CPH_IMPORT_READBACK_MISMATCH',caught.exception.code)
                self.assertEqual(before,options.prepare_to_save_all())
                options,main,dest,before,desired=self.fixture(mode)
                desired['human-unused']['dynamic_checkbox']=True;desired['human-unused']['extract_choice_index']=2
                with self.assertRaises(CphAtomicError) as caught:
                    atomic_import(options,main,'fixture:activate:'+mode,before,desired)
                self.assertEqual('CPH_CACHE_REFERENCE_ORDER',caught.exception.code)
                self.assertEqual('preflight',caught.exception.stage)
                self.assertEqual(0,options.native_imports)
                self.assertEqual(before,options.prepare_to_save_all())
        on_ui_thread(run)

unittest.main()
